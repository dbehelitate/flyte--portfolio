{
  "name": "Flyte Devbox",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  // The devbox runs a local Kubernetes cluster inside Docker, so we need
  // docker-in-docker and kubectl. The GitHub CLI sets Codespaces port visibility.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "helm": "none",
      "minikube": "none"
    }
  },

  // Minimum machine spec: the devbox runs fine on the 2-core Codespaces
  // machine (4 CPUs / 16 GB RAM), though 4-core is recommended for snappier
  // workflow runs.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

   // The Flyte devbox serves both the UI and the API on port 30080.
  "forwardPorts": [30080],
  "portsAttributes": {
    "30080": {
      "label": "Flyte UI / API",
      "protocol": "http"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh" 
}
